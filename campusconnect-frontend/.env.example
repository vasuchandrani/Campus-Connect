# CampusConnect Frontend Environment Variables
# Copy this file to .env and fill in your values

# Backend API URL (required for production, optional for local development)
# VITE_BACKEND_URL=http://localhost:8080
# VITE_BACKEND_URL=https://your-api-domain.com

# Razorpay public key (required for payment checkout)
VITE_RAZORPAY_KEY=rzp_test_REPLACE_WITH_YOUR_KEY

# Subscription Plans Configuration (JSON)
VITE_SUBSCRIPTION_PLANS=[{"id":"basic","name":"Basic","price":"₹999/month","amount":999,"durationInMonths":1,"isPopular":false,"isLimited":true,"features":["Up to 5 clubs","Email support","1 admin account"]},{"id":"enterprise","name":"Enterprise","price":"₹8,999 / 6 months","amount":8999,"durationInMonths":6,"isPopular":true,"isLimited":false,"features":["Unlimited clubs","Email support","24/7 support","Unlimited admins"]},{"id":"premium","name":"Premium","price":"₹1999/month","amount":1999,"isLimited":false,"durationInMonths":1,"isPopular":false,"features":["Unlimited clubs","Email support","24/7 support","Unlimited admins"]}]
